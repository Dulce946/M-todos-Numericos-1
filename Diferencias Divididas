    {
      "cell_type": "code",
      "source": [
        "def construir_y_graficar_newton(x_nodos, y_nodos, coeficientes):\n",
        "    \"\"\"\n",
        "    Toma los coeficientes de Newton, construye el polinomio simbólico con SymPy,\n",
        "    lo muestra en pantalla y genera su gráfica junto con los nodos originales.\n",
        "    \"\"\"\n",
        "    # sp.Symbol define 'x' como una variable matemática simbólica\n",
        "    x = sp.Symbol('x')\n",
        "\n",
        "    # Inicializamos el polinomio con el término independiente a_0 = F_{0,0}\n",
        "    polinomio = coeficientes[0]\n",
        "    termino_producto = 1\n",
        "\n",
        "    # Construimos la suma acumulada: a_i * (x - x_0)*(x - x_1)*...*(x - x_{i-1})\n",
        "    for i in range(1, len(coeficientes)):\n",
        "        termino_producto *= (x - x_nodos[i - 1])\n",
        "        polinomio += coeficientes[i] * termino_producto\n",
        "\n",
        "    # sp.expand() desarrolla los paréntesis para mostrar el polinomio simplificado\n",
        "    polinomio_expandido = sp.expand(polinomio)\n",
        "\n",
        "    print(\"Polinomio en forma de Newton:\")\n",
        "    sp.pprint(polinomio)\n",
        "    print(\"\\nPolinomio expandido P(x):\")\n",
        "    sp.pprint(polinomio_expandido)\n",
        "\n",
        "    # sp.plot() grafica directamente la expresión simbólica en el rango de los nodos\n",
        "    x_min, x_max = min(x_nodos) - 0.1, max(x_nodos) + 0.1\n",
        "\n",
        "    # Preparamos los puntos originales como marcadores para superponerlos en la gráfica\n",
        "    puntos_grafica = [\n",
        "        {'args': [x_nodos, y_nodos, 'ro'], 'ms': 7}\n",
        "    ]\n",
        "\n",
        "    grafico = sp.plot(\n",
        "        polinomio,\n",
        "        (x, x_min, x_max),\n",
        "        title='Interpolación de Newton (Ejemplo 1, Burden pág. 94)',\n",
        "        xlabel='x',\n",
        "        ylabel='P(x)',\n",
        "        line_color='blue',\n",
        "        markers=puntos_grafica,\n",
        "        show=True\n",
        "    )\n",
        "\n",
        "    return polinomio, polinomio_expandido"
      ],

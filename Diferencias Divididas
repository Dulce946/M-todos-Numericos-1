      "source": [
        "# Datos del Ejemplo 1 (página 94 de Burden)\n",
        "x_datos = [1.0, 1.3, 1.6, 1.9, 2.2]\n",
        "y_datos = [0.7651977, 0.6200860, 0.4554022, 0.2818186, 0.1103623]\n",
        "\n",
        "# Calculamos la tabla y los coeficientes\n",
        "tabla_F, coefs = diferencias_divididas_newton(x_datos, y_datos)\n",
        "\n",
        "# Mostramos la tabla completa formateada con Pandas\n",
        "columnas = [f\"Orden {j}\" for j in range(len(x_datos))]\n",
        "df_tabla = pd.DataFrame(tabla_F, columns=columnas)\n",
        "df_tabla.insert(0, \"x_i\", x_datos)\n",
        "\n",
        "print(\"Tabla de Diferencias Divididas de Newton:\")\n",
        "display(df_tabla.round(7))\n",
        "\n",
        "# Resaltamos los coeficientes finales F_{i,i}\n",
        "print(\"\\n\")\n",
        "print(\"SOLUCIÓN FINAL - Coeficientes del polinomio (F_{i,i}):\")\n",
        "for i, c in enumerate(coefs):\n",
        "    print(f\"  a_{i} = F_{{{i},{i}}} = {c:.7f}\")\n",
        "print(\"\\n\")\n",
        "\n",
        "# 3. Escribimos y graficamos el polinomio usando SymPy\n",
        "P_newton, P_expandido = construir_y_graficar_newton(x_datos, y_datos, coefs)\n",
        "\n",
        "# Evaluación adicional en x = 1.5 (comprobación del Ejemplo 1 de Burden)\n",
        "x_sym = sp.Symbol('x')\n",
        "valor_1_5 = float(P_newton.subs(x_sym, 1.5))\n",
        "print(f\"\\n>>> Evaluación de comprobación P(1.5) = {valor_1_5:.7f} <<<\")"
      ],
